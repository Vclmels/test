$modelname "fishing/boss_mutatedwhale.mdl"
$cdmaterials "models/fishing/"
$body "body" "boss_mutatedwhale_reference.smd"
$sequence "idle" "boss_mutatedwhale_reference.smd" fps 30
$collisionmodel "boss_mutatedwhale_physics.smd"
{
	$mass 400.0
	$inertia 1
	$damping 0
	$rotdamping 0
}
$surfaceprop "flesh"
